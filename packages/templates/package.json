{
  "name": "@cv-express/templates",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Motor de geração do .tex e ponto único de escape de LaTeX",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cv-express/i18n": "workspace:*",
    "@cv-express/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.4"
  }
}
