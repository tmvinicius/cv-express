{
  "name": "cv-express",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gerador de currículos em LaTeX com saída em PDF",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r run test:watch",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "verificar": "pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
