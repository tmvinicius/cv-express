{
  "name": "@cv-express/latex-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Serviço de compilação LaTeX em sandbox",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@cv-express/schema": "workspace:*",
    "@cv-express/templates": "workspace:*",
    "fastify": "^5.2.0"
  }
}
