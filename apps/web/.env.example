# ==============================================================================
#  CV Express — variáveis do app web
#
#  Copie para apps/web/.env.local (o Next lê esse arquivo em `pnpm dev`; ele
#  está no .gitignore). Em produção, defina as mesmas no painel da Vercel.
#
#  Esta é a lista COMPLETA do que o app lê — e um teste cobra isso
#  (src/__tests__/envExemplo.test.ts): uma variável lida no código e ausente
#  daqui, ou listada aqui e lida por ninguém, reprova. Uma variável que só o
#  autor conhece é uma configuração que quebra na primeira máquina nova.
#
#  Os valores abaixo batem com o docker-compose.yml da raiz. Nada aqui é
#  segredo de verdade: em produção, todo valor marcado [SEGREDO] é outro.
# ==============================================================================


# ── Banco ────────────────────────────────────────────────────────────────────
# Obrigatória. Sem ela nenhuma página abre.
# Depois de subir o banco (ou atualizar o código), aplique as migrações:
#   DATABASE_URL=... pnpm migrar
DATABASE_URL=postgres://cvexpress:dev@localhost:5432/cvexpress


# ── Endereço público ─────────────────────────────────────────────────────────
# Base do link enviado por e-mail. Obrigatória em produção; em desenvolvimento
# o padrão é http://localhost:3000. Nunca é deduzida do cabeçalho Host, que
# quem faz a requisição controla.
APP_URL=http://localhost:3000


# ── Worker de LaTeX ──────────────────────────────────────────────────────────
# Sem os dois, o formulário funciona e o preview avisa que o gerador de PDF
# está indisponível. O token é o MESMO WORKER_TOKEN configurado no worker.
WORKER_URL=http://localhost:8080
WORKER_TOKEN=token-local-nao-use-em-producao                 # [SEGREDO]


# ── IA ───────────────────────────────────────────────────────────────────────
# anthropic | openai-compativel | mock. `mock` não chama rede nem gasta nada.
# Sem configuração válida, o botão da IA aparece desligado — o resto funciona.
AI_PROVIDER=mock

# Com anthropic: a chave (AI_API_KEY tem prioridade; ANTHROPIC_API_KEY e
# ANTHROPIC_AUTH_TOKEN também são aceitas). AI_MODEL é opcional: o padrão
# está em MODELO_PADRAO, em packages/ai/src/adapters/anthropic.ts.
# AI_API_KEY=                                                # [SEGREDO]
# AI_MODEL=

# Com openai-compativel (Ollama, vLLM, LM Studio, OpenRouter…): URL e modelo
# são obrigatórios; a chave é opcional em modelo local.
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1
# AI_SUPORTE_JSON=nativo        # nativo | modo_json | nenhum

# Pedidos à IA por dia, somando todo mundo (dia de UTC). Padrão 1000; 0
# desliga a ajuda sem tirar a chave. Ajuste ao orçamento: o gasto real de
# cada dia fica na tabela uso_ia (consulta no README).
# IA_TETO_DIARIO=1000


# ── E-mail do "Concluir e salvar" ────────────────────────────────────────────
# console: escreve o e-mail, com o link, no terminal — para testar sem conta.
#          Recusado em produção (o link é uma chave do currículo e iria para o
#          log).
# resend:  envio real. O remetente precisa ser de domínio verificado no Resend.
EMAIL_PROVIDER=console
# RESEND_API_KEY=                                            # [SEGREDO]
# EMAIL_REMETENTE=CV Express <nao-responda@seudominio.com.br>


# ── Expurgo diário ───────────────────────────────────────────────────────────
# Protege GET /api/tarefas/expurgo, que apaga os dados vencidos. Na Vercel, o
# cron de apps/web/vercel.json envia este valor sozinho. Sem ele a rota recusa
# (503) e NADA é apagado — em produção, isso descumpre a retenção declarada.
# Gere com: openssl rand -hex 32
CRON_SECRET=segredo-local-nao-use-em-producao                # [SEGREDO]


# ── Privacidade (LGPD) ───────────────────────────────────────────────────────
# Canal de contato do responsável pelos dados, mostrado em /privacidade. A
# LGPD exige um. Sem ele a página diz que não está configurado — não publique
# assim.
# PRIVACIDADE_CONTATO=privacidade@seudominio.com.br
